# --- amoCRM ---
AMOCRM_BASE_URL=https://yourdomain.amocrm.ru
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
# Заполняются автоматически после первого OAuth-обмена (см. README), можно оставить пустыми
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# ID воронки Partners и этапов (посмотреть в amoCRM: Настройки -> Воронки, или через API /leads/pipelines)
AMOCRM_PIPELINE_ID=
AMOCRM_STAGE_NEW_CONTACT_ID=
AMOCRM_STAGE_NEGOTIATIONS_ID=
AMOCRM_STAGE_CLARIFICATION_ID=
AMOCRM_STAGE_SILENCE_ID=
AMOCRM_STAGE_MANUAL_REVIEW_ID=
AMOCRM_STAGE_BLOCKED_ID=
AMOCRM_STAGE_TAKEN_BY_PARTNER_ID=

# ID полей сделки (Настройки -> Поля сделок, или через API /leads/custom_fields)
AMOCRM_FIELD_ID_TELEGRAM=
AMOCRM_FIELD_ID_STACK=
AMOCRM_FIELD_ID_CASE=
# "Полное ТЗ" — общее поле со сценарием "Выдача кейсов партнёрам" (см. Логика ИИ агента.md)
AMOCRM_FIELD_ID_FULL_SPEC=
# "Партнер ник" — куда сценарий "Выдача кейсов партнёрам" пишет взявшего кейс партнёра
AMOCRM_FIELD_ID_PARTNER_NICK=

# ID пользователя Варвары Ковригиной в amoCRM (для назначения задач)
AMOCRM_VARVARA_USER_ID=
# Этап "отправлено в группу" — сценарий "Выдача кейсов партнёрам" (main_cases.py)
AMOCRM_STAGE_SENT_TO_GROUP_ID=

# --- Telegram (личный аккаунт, MTProto через Telethon) — используется main.py ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=data/telegram.session

# --- Telegram Bot API + вторая telethon-сессия — используется main_cases.py (сценарий
# "Выдача кейсов партнёрам") — отдельный процесс, независимый от main.py ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Второе "устройство" того же аккаунта (тот же TELEGRAM_API_ID/API_HASH/PHONE выше, но свой
# session-файл) — нужно для создания групповых чатов без конфликта с сессией main.py
TELEGRAM_CASES_SESSION_PATH=data/telegram_cases.session
TELEGRAM_CASES_TOPIC_ID=

# --- Anthropic (классификация ответов) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Email fallback (сейчас используется Яндекс Почта: smtp.yandex.ru / imap.yandex.ru) ---
# EMAIL_SMTP_PASSWORD/EMAIL_IMAP_PASSWORD — пароль ПРИЛОЖЕНИЯ (Яндекс ID -> Пароли и авторизация
# -> Пароли приложений -> Почта), не обычный пароль от аккаунта.
EMAIL_FROM_ADDRESS=
EMAIL_SUBJECT=Ваша заявка на интеграцию — Альбато
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=

# --- Отчётность в вебхук (Albato) — P-014 в BACKLOG.md ---
REPORT_WEBHOOK_URL=
# Часы отчёта по TIMEZONE, через запятую (срочные алерты об ошибках — сразу, не по расписанию)
REPORT_HOURS=10,16

# --- Общие настройки ---
TIMEZONE=Europe/Moscow
DB_PATH=data/app.db
DB_CASES_PATH=data/app_cases.db
AMOCRM_POLL_INTERVAL_SECONDS=90
SCHEDULER_TICK_SECONDS=60
DAILY_TELEGRAM_SEND_CAP=500
REMINDER_HOUR_LOCAL=14
